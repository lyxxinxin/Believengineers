
import cv2
import mediapipe as mp
import numpy as np
import math
import urllib.request
import os

model_path = "pose_landmarker_lite.task"

if not os.path.exists(model_path):
    print("Downloading AI model...")
    url = (
        "https://storage.googleapis.com/mediapipe-models/"
        "pose_landmarker/pose_landmarker_lite/float16/1/"
        "pose_landmarker_lite.task"
    )
    urllib.request.urlretrieve(url, model_path)

# Set up MediaPipe

BaseOptions = mp.tasks.BaseOptions
PoseLandmarker = mp.tasks.vision.PoseLandmarker
PoseLandmarkerOptions = mp.tasks.vision.PoseLandmarkerOptions
RunningMode = mp.tasks.vision.RunningMode

options = PoseLandmarkerOptions(
    base_options=BaseOptions(model_asset_path=model_path),
    running_mode=RunningMode.IMAGE,
    num_poses=1
)

# Body landmark connections

connections = [
    (11, 12),
    (11, 13), (13, 15),
    (12, 14), (14, 16),
    (11, 23), (12, 24),
    (23, 24)
]

#Functions for angle calculations

def calculate_angle(a, b, c):
    """Calculate angle ABC in degrees."""
    a = np.array(a, dtype=float)
    b = np.array(b, dtype=float)
    c = np.array(c, dtype=float)

    ba = a - b
    bc = c - b

    denominator = (
        np.linalg.norm(ba) *
        np.linalg.norm(bc)
    )

    if denominator < 1e-8:
        return None

    cosine = np.dot(ba, bc) / denominator
    cosine = np.clip(cosine, -1.0, 1.0)

    return math.degrees(math.acos(cosine))


def calculate_trunk_angle(shoulder, hip):
    """Calculate trunk inclination from vertical."""
    dx = shoulder[0] - hip[0]
    dy = shoulder[1] - hip[1]

    return math.degrees(
        math.atan2(abs(dx), abs(dy))
    )


def midpoint(a, b):
    return (
        (a[0] + b[0]) / 2,
        (a[1] + b[1]) / 2
    )



# Open laptop camera

camera = cv2.VideoCapture(0)

if not camera.isOpened():
    raise RuntimeError("Cannot open camera!")

print("Believengineer AI started!")
print("Raise your arms sideways.")
print("Press Q to exit.")

# AI tracking and measurements

try:
    with PoseLandmarker.create_from_options(options) as landmarker:

        while True:
            success, frame = camera.read()

            if not success:
                break

            frame = cv2.flip(frame, 1)

            height, width = frame.shape[:2]

            rgb = cv2.cvtColor(
                frame, cv2.COLOR_BGR2RGB
            )

            mp_image = mp.Image(
                image_format=mp.ImageFormat.SRGB,
                data=rgb
            )

            result = landmarker.detect(mp_image)

            if result.pose_landmarks:
                landmarks = result.pose_landmarks[0]
                points = {}

                for i, landmark in enumerate(landmarks):
                    points[i] = (
                        int(landmark.x * width),
                        int(landmark.y * height)
                    )

                # Draw skeleton
                for start, end in connections:
                    cv2.line(
                        frame,
                        points[start],
                        points[end],
                        (0, 255, 0),
                        3
                    )

                for index in [
                    11, 12, 13, 14, 15, 16,
                    23, 24
                ]:
                    cv2.circle(
                        frame,
                        points[index],
                        5,
                        (0, 0, 255),
                        -1
                    )

                # Shoulder angle relative to trunk (upper arm vs hip)
                left_arm = calculate_angle(
                    points[13],  # Left elbow
                    points[11],  # Left shoulder
                    points[23]   # Left hip
                )

                right_arm = calculate_angle(
                    points[14],  # Right elbow
                    points[12],  # Right shoulder
                    points[24]   # Right hip
                )

                # Trunk inclination

                shoulder_mid = midpoint(
                    points[11], points[12]
                )

                hip_mid = midpoint(
                    points[23], points[24]
                )

                trunk_angle = calculate_trunk_angle(
                    shoulder_mid,
                    hip_mid
                )
                if trunk_angle > 5:
                    status = "Trunk Compensation Detected!"
                else:
                    status = "No Trunk Compensation"

                # Display results

                cv2.rectangle(
                    frame,
                    (0, 0),
                    (440, 145),
                    (30, 30, 30),
                    -1
                )

                if left_arm is not None:
                    cv2.putText(
                        frame,
                        f"Right Arm: {left_arm:.1f} deg",
                        (15, 35),
                        cv2.FONT_HERSHEY_SIMPLEX,
                        0.7,
                        (255, 255, 255),
                        2
                    )

                if right_arm is not None:
                    cv2.putText(
                        frame,
                        f"Left Arm: {right_arm:.1f} deg",
                        (15, 70),
                        cv2.FONT_HERSHEY_SIMPLEX,
                        0.7,
                        (255, 255, 255),
                        2
                    )

                cv2.putText(
                    frame,
                    f"Trunk Lean: {trunk_angle:.1f} deg",
                    (15, 105),
                    cv2.FONT_HERSHEY_SIMPLEX,
                    0.7,
                    (225, 225, 255) if status == "No Trunk Compensation" else (0, 0, 255),
                    2
                )
                if trunk_angle > 5:
                    cv2.putText(
                        frame,
                        "Trunk Leaning Detected!",
                        (15, 140),
                         cv2.FONT_HERSHEY_SIMPLEX,
                         0.7,
                        (0, 0, 255),
                         2
                    )
                

               

            cv2.imshow(
                "Believengineer - Rehabilitation AI",
                frame
            )

            if cv2.waitKey(1) & 0xFF == ord("q"):
                break

finally:
    camera.release()
    cv2.destroyAllWindows()
